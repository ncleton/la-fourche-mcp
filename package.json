{
  "name": "la-fourche-mcp",
  "version": "0.1.0",
  "description": "Unofficial La Fourche MCP server and CLI: catalogue search, product details and a confirmed shopping cart, backed by a user-owned persistent Camoufox browser session.",
  "license": "MIT",
  "type": "module",
  "main": "dist/client/shop.js",
  "types": "dist/client/shop.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client/shop.d.ts",
      "import": "./dist/client/shop.js"
    },
    "./server": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    }
  },
  "bin": {
    "la-fourche-mcp": "dist/mcp/server.js",
    "la-fourche": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/cli.d.ts",
    "dist/client",
    "dist/mcp",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CONTRIBUTING.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "node dist/mcp/server.js",
    "live:smoke": "npm run build && node dist/scripts/live-smoke.js",
    "privacy:audit": "node dist/scripts/privacy-audit.js",
    "package:verify": "npm pack --dry-run",
    "verify": "npm run check && npm test && npm run privacy:audit && npm run package:verify"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "la-fourche",
    "lafourche-next",
    "grocery",
    "camoufox",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ncleton/la-fourche-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ncleton/la-fourche-mcp/security/advisories/new"
  },
  "homepage": "https://github.com/ncleton/la-fourche-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "17.2.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.2.3",
    "typescript": "7.0.2"
  }
}
